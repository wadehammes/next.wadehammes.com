{
  "name": "next-wade-hammes",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev -p 4431",
    "build": "next build",
    "start": "next start -p 4431",
    "tsc:ci": "tsc --strict",
    "lint": "biome check",
    "lint:ci": "biome ci --reporter=github",
    "lint:fix": "biome check --fix",
    "lint:changed": "biome check --changed --since origin/staging --no-errors-on-unmatched --verbose --write --diagnostic-level=error",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:all": "pnpm lint:changed && pnpm lint:css:fix && pnpm tsc:ci && pnpm knip:ci",
    "test:ci": "jest --passWithNoTests",
    "types:prismic": "prismic-ts-codegen",
    "prismic:update-home-seo": "node scripts/update-home-seo.cjs",
    "prismic:update-home-bio": "node scripts/update-home-bio.cjs",
    "prismic:update-links-content": "node scripts/update-links-content.cjs",
    "knip": "knip",
    "knip:ci": "knip --no-progress",
    "handbook:check": "bash scripts/handbook-sync-check.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@next/third-parties": "^16.4.0",
    "@prismicio/client": "^7.22.3",
    "@prismicio/next": "^2.3.3",
    "@prismicio/react": "^3.5.1",
    "@svgr/webpack": "^8.1.0",
    "classnames": "^2.5.1",
    "culori": "^4.0.2",
    "gsap": "^3.15.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intersection-observer": "^11.0.1",
    "server-only": "^0.0.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@faker-js/faker": "^10.6.0",
    "@jest/globals": "^30.5.2",
    "@jest/types": "^30.5.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^18.0.6",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "knip": "^6.40.0",
    "prismic-ts-codegen": "^0.1.30",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "^7.0.2"
  }
}
